{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neumorphic High-DPI Asset and Coordinate Scaling Matrix",
  "description": "Exact coordinate metrics, sizing margins, content margins, and shadow offsets across standard Windows DPI scales",
  "scales": {
    "100%": {
      "dpi": 96,
      "scaleFactor": 1.0,
      "metrics": {
        "Button": {
          "minWidth": 75,
          "minHeight": 24,
          "cornerRadius": 8,
          "contentMargins": { "left": 12, "top": 4, "right": 12, "bottom": 4 },
          "sizingMargins": { "left": 6, "top": 6, "right": 6, "bottom": 6 },
          "shadowBlur": 6,
          "shadowOffset": 3
        },
        "CaptionButtons": {
          "width": 45,
          "height": 29,
          "glyphSize": 10,
          "cornerRadius": 6
        },
        "TrackBar": {
          "trackHeight": 6,
          "thumbWidth": 16,
          "thumbHeight": 16,
          "thumbRadius": 8,
          "shadowBlur": 4
        },
        "ScrollBar": {
          "size": 15,
          "thumbMinLength": 24,
          "arrowButtonSize": 15,
          "cornerRadius": 4
        },
        "EditControl": {
          "borderPadding": 4,
          "innerShadowOffset": 2,
          "cornerRadius": 6
        },
        "CardContainer": {
          "cornerRadius": 16,
          "shadowSpread": 4,
          "shadowBlur": 12,
          "shadowOffset": 6
        }
      }
    },
    "125%": {
