; ------------------------------------------------------------------------------
; 2. Modern Windows Personalization & System Dark Mode Flags
; Enforces dark surfaces across UWP, WinUI, File Explorer, and Win32
; ------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"AppsUseLightTheme"=dword:00000000
"SystemUsesLightTheme"=dword:00000000
"EnableTransparency"=dword:00000001
"ColorPrevalence"=dword:00000001

; ------------------------------------------------------------------------------
; 3. Desktop Window Manager (DWM) Attributes & Accent Lighting
; Accent Color: #38BDF8 with soft alpha blending for subtle glass reflection
; ------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Microsoft\Windows\DWM]
"AccentColor"=dword:fff8bd38
"AccentColorInactive"=dword:ff242528
"ColorizationColor"=dword:6638bdf8
"ColorizationAfterglow"=dword:6638bdf8
"ColorizationBlurBalance"=dword:0000001e
"ColorizationGlassAttribute"=dword:00000001
"Composition"=dword:00000001
"ColorPrevalence"=dword:00000001

; ------------------------------------------------------------------------------
; 4. ClearType Subpixel Font Rendering & Smoothing Calibration
; Ensures high-contrast crisp text rendering against dark neumorphic matte
; ------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Desktop]
"FontSmoothing"="2"
"FontSmoothingType"=dword:00000002
"FontSmoothingGamma"=dword:00000578
"FontSmoothingOrientation"=dword:00000001

; ------------------------------------------------------------------------------
; 5. Modern Shell Context Menus & Padding Customization
; Restores clean padded context menus matching dark neumorphic surfaces
; ------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarAnimations"=dword:00000001
"TaskbarSizeMove"=dword:00000000
"ListviewAlphaSelect"=dword:00000001
"ListviewShadow"=dword:00000000
