<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/NeumorphicTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================================================================== -->
    <!-- 1. NEUMORPHIC CARD CONTAINER (EXTRUDED SURFACE)                      -->
    <!-- ==================================================================== -->
    <Style x:Key="NeumorphicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeumorphicConvexBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource NeumorphicCardRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeumorphicBezelBrush}"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="NeumorphicSunkenCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeumorphicConcaveBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource NeumorphicCardRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#25000000"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ==================================================================== -->
    <!-- 2. NEUMORPHIC TACTILE PUSH BUTTON                                    -->
    <!-- ==================================================================== -->
    <Style x:Key="NeumorphicButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NeumorphicTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <!-- Bottom-Right Occlusion Soft Drop Shadow -->
                        <Border x:Name="DropShadow"
                                Margin="3,3,-3,-3"
                                Background="{StaticResource NeumorphicLowShadowBrush}"
                                CornerRadius="{StaticResource NeumorphicControlRadius}"
                                Opacity="0.6"/>

                        <!-- Top-Left Soft Specular Highlight Reflection -->
                        <Border x:Name="HighlightShadow"
                                Margin="-3,-3,3,3"
                                Background="{StaticResource NeumorphicHighlightLightBrush}"
                                CornerRadius="{StaticResource NeumorphicControlRadius}"
                                Opacity="0.9"/>

                        <!-- Button Main Extruded Surface -->
                        <Border x:Name="ButtonSurface"
                                Background="{StaticResource NeumorphicConvexBrush}"
                                CornerRadius="{StaticResource NeumorphicControlRadius}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NeumorphicBezelBrush}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonSurface.Background" Value="#FF252830"/>
                                        <Setter Target="HighlightShadow.Opacity" Value="1.0"/>
                                        <Setter Target="DropShadow.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="DropShadow.Opacity" Value="0"/>
                                        <Setter Target="HighlightShadow.Opacity" Value="0"/>
                                        <Setter Target="ButtonSurface.Background" Value="{StaticResource NeumorphicConcaveBrush}"/>
                                        <Setter Target="ButtonSurface.BorderBrush" Value="#40000000"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="DropShadow.Opacity" Value="0.2"/>
                                        <Setter Target="HighlightShadow.Opacity" Value="0.2"/>
                                        <Setter Target="ButtonSurface.Opacity" Value="0.45"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- 3. NEUMORPHIC ICON PILL BUTTON (FOR BOTTOM NAV BAR)                  -->
    <!-- ==================================================================== -->
    <Style x:Key="NeumorphicIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Foreground" Value="{StaticResource NeumorphicTextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- Extruded state shadows (Visible when Unchecked) -->
                        <Border x:Name="ExtrudedShadowDark"
                                Margin="2,2,-2,-2"
                                Background="{StaticResource NeumorphicLowShadowBrush}"
                                CornerRadius="24"
                                Opacity="0.5"/>
                        <Border x:Name="ExtrudedHighlightLight"
                                Margin="-2,-2,2,2"
                                Background="{StaticResource NeumorphicHighlightLightBrush}"
                                CornerRadius="24"
                                Opacity="0.8"/>

                        <!-- Button Body -->
                        <Border x:Name="ToggleBody"
                                Background="{StaticResource NeumorphicConvexBrush}"
                                CornerRadius="24"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NeumorphicBezelBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ExtrudedShadowDark.Opacity" Value="0"/>
                                        <Setter Target="ExtrudedHighlightLight.Opacity" Value="0"/>
                                        <Setter Target="ToggleBody.Background" Value="{StaticResource NeumorphicConcaveBrush}"/>
                                        <Setter Target="ToggleBody.BorderBrush" Value="#40000000"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- 4. NEUMORPHIC TACTILE SLIDER                                         -->
    <!-- ==================================================================== -->
    <Style x:Key="NeumorphicSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Margin="{TemplateBinding Padding}">
                        <Grid.Resources>
                            <Style TargetType="Thumb">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="22" Height="22">
                                                <Border Background="{StaticResource NeumorphicLowShadowBrush}"
                                                        CornerRadius="11" Margin="2,2,-2,-2" Opacity="0.7"/>
                                                <Border Background="{StaticResource NeumorphicHighlightLightBrush}"
                                                        CornerRadius="11" Margin="-2,-2,2,2" Opacity="0.8"/>
                                                <Border Background="{StaticResource NeumorphicConvexBrush}"
                                                        CornerRadius="11" BorderThickness="1"
                                                        BorderBrush="{StaticResource NeumorphicBezelBrush}">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource NeumorphicAccentCyanBrush}"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid x:Name="HorizontalTemplate">
                            <Border x:Name="HorizontalTrackRect" Height="8"
                                    Background="{StaticResource NeumorphicInsetBrush}"
                                    CornerRadius="4" BorderThickness="1" BorderBrush="#25000000"/>
                            <Border x:Name="HorizontalDecreaseRect" Height="8"
                                    Background="{StaticResource NeumorphicAccentGradientBrush}"
                                    CornerRadius="4" HorizontalAlignment="Left"/>
                            <Thumb x:Name="HorizontalThumb" Height="22" Width="22"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
