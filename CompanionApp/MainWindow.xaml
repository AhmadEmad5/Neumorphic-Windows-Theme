<Window
    x:Class="NeumorphicEngine.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeumorphicEngine">

    <Grid Background="#FF18191C">
        <!-- Root Outer Tactile Container -->
        <Border Margin="18"
                Background="{StaticResource NeumorphicConvexBrush}"
                CornerRadius="{StaticResource NeumorphicContainerRadius}"
                BorderThickness="1"
                BorderBrush="{StaticResource NeumorphicBezelBrush}">
            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Bar & Pin Button -->
                    <RowDefinition Height="Auto"/> <!-- Status & Digital Readout -->
                    <RowDefinition Height="*"/>    <!-- Tactile Rotary Knob & Visualizer -->
                    <RowDefinition Height="Auto"/> <!-- Lower Recessed Nav-Pill Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header Drag Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" PointerPressed="Header_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource NeumorphicAccentCyanBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="NEUMORPHIC AUDIO HUD"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   CharacterSpacing="80"
                                   Foreground="{StaticResource NeumorphicTextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PinButton"
                                Style="{StaticResource NeumorphicButtonStyle}"
                                Padding="8,4"
                                Click="PinButton_Click">
                            <TextBlock x:Name="PinText" Text="📌 Pin" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource NeumorphicButtonStyle}"
                                Padding="8,4"
                                Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="11" Foreground="#FFF43F5E"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Digital Readout Panel (Recessed / Sunken) -->
                <Border Grid.Row="1"
                        Style="{StaticResource NeumorphicSunkenCardStyle}"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MASTER GAIN"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       CharacterSpacing="60"
                                       Foreground="{StaticResource NeumorphicTextMutedBrush}"/>
                            <TextBlock x:Name="VolumePercentText"
                                       Text="72%"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       Foreground="{StaticResource NeumorphicTextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Audio dB Sub-readout -->
                        <Border Grid.Column="1"
                                Background="#FF1E2024"
                                CornerRadius="8"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NeumorphicBezelBrush}">
                            <TextBlock x:Name="DbText"
                                       Text="-4.2 dB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NeumorphicAccentCyanBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Central Rotary Knob & Segmented LED Visualizer -->
                <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Circular Extruded Rotary Dial -->
                    <Grid Width="210" Height="210"
                          PointerPressed="Knob_PointerPressed"
                          PointerMoved="Knob_PointerMoved"
                          PointerReleased="Knob_PointerReleased">
                        
                        <!-- Dial Outer Circumferential Soft Shadow Base -->
                        <Border Width="196" Height="196"
                                Margin="8,8,-8,-8"
                                CornerRadius="98"
                                Background="{StaticResource NeumorphicDeepShadowBrush}"
                                Opacity="0.5"/>

                        <Border Width="196" Height="196"
                                Margin="-8,-8,8,8"
                                CornerRadius="98"
                                Background="{StaticResource NeumorphicHighlightLightBrush}"
                                Opacity="0.8"/>

                        <!-- Dial Body -->
                        <Border x:Name="DialBody"
                                Width="190" Height="190"
                                CornerRadius="95"
                                Background="{StaticResource NeumorphicConvexBrush}"
                                BorderThickness="1.5"
                                BorderBrush="{StaticResource NeumorphicBezelBrush}">
                            <Grid>
                                <!-- Sunken Circular Core -->
                                <Border Width="130" Height="130"
                                        CornerRadius="65"
                                        Background="{StaticResource NeumorphicConcaveBrush}"
                                        BorderThickness="1"
                                        BorderBrush="#33000000">
                                    <Grid>
                                        <!-- Central Extruded Cap -->
                                        <Border Width="80" Height="80"
                                                CornerRadius="40"
                                                Background="{StaticResource NeumorphicConvexBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource NeumorphicBezelBrush}">
                                            <!-- Rotary Pointer Indicator Dot -->
                                            <Grid x:Name="PointerTransformHost" RenderTransformOrigin="0.5, 0.5">
                                                <Grid.RenderTransform>
                                                    <RotateTransform x:Name="KnobRotateTransform" Angle="72"/>
                                                </Grid.RenderTransform>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource NeumorphicAccentCyanBrush}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,10,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Stepped Segmented LED Visualizer Bar -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="5"
                                Margin="0,24,0,0">
                        <!-- 12 Segmented LED bars -->
                        <Border x:Name="Bar1"  Width="6" Height="14" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar2"  Width="6" Height="16" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar3"  Width="6" Height="18" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar4"  Width="6" Height="20" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar5"  Width="6" Height="22" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar6"  Width="6" Height="24" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar7"  Width="6" Height="26" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar8"  Width="6" Height="28" CornerRadius="3" Background="{StaticResource NeumorphicAccentCyanBrush}"/>
                        <Border x:Name="Bar9"  Width="6" Height="26" CornerRadius="3" Background="{StaticResource NeumorphicInsetBrush}"/>
                        <Border x:Name="Bar10" Width="6" Height="24" CornerRadius="3" Background="{StaticResource NeumorphicInsetBrush}"/>
                        <Border x:Name="Bar11" Width="6" Height="20" CornerRadius="3" Background="{StaticResource NeumorphicInsetBrush}"/>
                        <Border x:Name="Bar12" Width="6" Height="16" CornerRadius="3" Background="{StaticResource NeumorphicInsetBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Lower Nav-Pill Bar (Sunken Capsule Container) -->
                <Border Grid.Row="3"
                        Margin="0,20,0,0"
                        Background="{StaticResource NeumorphicConcaveBrush}"
                        CornerRadius="26"
                        BorderThickness="1"
                        BorderBrush="#33000000"
                        Padding="6">
                    <Grid HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <!-- Home Button -->
                            <ToggleButton Style="{StaticResource NeumorphicIconToggleStyle}" IsChecked="True">
                                <TextBlock Text="🏠" FontSize="16"/>
                            </ToggleButton>

                            <!-- Heart Button -->
                            <ToggleButton Style="{StaticResource NeumorphicIconToggleStyle}">
                                <TextBlock Text="♥" FontSize="16" Foreground="#FFF43F5E"/>
                            </ToggleButton>

                            <!-- Bell Button -->
                            <ToggleButton Style="{StaticResource NeumorphicIconToggleStyle}">
                                <TextBlock Text="🔔" FontSize="16"/>
                            </ToggleButton>

                            <!-- Settings Button -->
                            <ToggleButton Style="{StaticResource NeumorphicIconToggleStyle}">
                                <TextBlock Text="⚙" FontSize="16"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
